{
  "name": "arc-play-flag",
  "version": "0.0.0-development",
  "description": "Flag Football Play Designer — a 5v5 flag-football whiteboard",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "demo:setup": "playwright install chromium",
    "demo:record": "bun run scripts/demo-recorder.ts",
    "icons": "bun run scripts/optimize-icons.ts",
    "release": "semantic-release"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "latest",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "semantic-release": "^25.0.9",
    "sharp": "^0.34.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
